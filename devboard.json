{
  "icon": "docs/logo/ignite-icon.svg",
  "staging": {
    "url": "http://localhost:5199",
    "start": "bash scripts/start-catalog.sh",
    "command": "bash scripts/build-catalog.sh",
    "note": "main取り込み後にカタログをビルド。URLを開くと専用サーバーを起動する"
  },
  "workflow": {
    "base": "main",
    "setup": "npm ci",
    "test": "bash scripts/test.sh"
  },
  "production": {
    "branch": "release",
    "command": "node scripts/release.mjs",
    "note": "固定コミットを検査し、tgz・SHA256・COMMITをPrivate GitHub Releaseへ配布する"
  }
}
