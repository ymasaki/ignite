{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "paths": { "@ymasaki/ignite": ["./src/index.ts"], "@ymasaki/ignite/audit": ["./audit/index.ts"] }
  },
  "include": ["src", "cli", "audit", "catalog", "tests", "scripts/health/benchmarks.ts"],
  "exclude": ["catalog/vite.config.ts"]
}
