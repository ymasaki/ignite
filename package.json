{
  "name": "@ymasaki/ignite",
  "version": "1.20.4",
  "description": "Web・デスクトップのアプリで同じ見た目と使い勝手をそろえるデザインシステム",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ymasaki/ignite.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "ignite": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit.js"
    },
    "./DESIGN.md": "./DESIGN.md",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "DESIGN.md",
    "CHANGELOG.md",
    "docs",
    "templates"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "test": "vitest run --dir tests",
    "catalog": "vite catalog",
    "check:design": "node dist/cli.js check",
    "audit:design": "node scripts/audit-design.mjs",
    "smoke": "node scripts/smoke.mjs",
    "perf:catalog": "node scripts/perf/catalog.mjs",
    "perf:parts": "node scripts/perf/parts.mjs",
    "health:analysis": "node scripts/health/run.mjs analysis",
    "health:coverage": "node scripts/health/run.mjs coverage",
    "health:benchmarks": "node scripts/health/run.mjs benchmarks"
  },
  "peerDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "@tabler/icons-react": "^3.48.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.65.1",
    "@tabler/icons-react": "^3.51.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jscpd": "5.4.3",
    "jsdom": "31.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "minimatch@^9": "11.0.9",
    "minimatch@^10": "11.0.9"
  }
}
